[Desktop Entry]
Name=Aura
Comment=Desktop music player — YouTube Music, lossless audio, Last.fm scrobbling
Exec=/opt/aura/aura_desktop %u
Icon=aura
Terminal=false
Type=Application
Categories=Audio;Music;AudioVideo;
MimeType=x-scheme-handler/aura;x-scheme-handler/lastwave;
StartupWMClass=aura_desktop
