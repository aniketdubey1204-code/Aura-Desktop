# Aura — AppImage desktop entry.
# Exec is the bare binary name: inside the AppImage the executable lives at
# $APPDIR/usr/bin and there is no /opt/aura.
[Desktop Entry]
Name=Aura
Comment=Desktop music player — YouTube Music, lossless audio, Last.fm scrobbling
Exec=aura_desktop %u
Icon=aura
Terminal=false
Type=Application
Categories=Audio;Music;AudioVideo;
MimeType=x-scheme-handler/aura;x-scheme-handler/lastwave;
StartupWMClass=aura_desktop
